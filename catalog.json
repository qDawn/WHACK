{
  "entries": [
    {
      "id": "open_godot",
      "title": "Godot coursework",
      "detail": "${godotProject}",
      "method": "command",
      "command": ["${godotEditor}", "--editor", "--path", "${godotProjectDir}"]
    },
    {
      "id": "open_godot_editor",
      "title": "Godot",
      "detail": "Godot",
      "method": "command",
      "command": ["${godotEditor}", "--project-manager"]
    },
    {
      "id": "open_terminal",
      "title": "Terminal",
      "detail": "${gitRepo}",
      "method": "command",
      "command": [
        "wt.exe",
        "-d",
        "${gitRepo}"
      ],
      "directoryFallback": "C:\\Users\\nggro",
      "fallback": [
        "powershell.exe",
        "-NoExit",
        "-Command",
        "Set-Location -LiteralPath '${gitRepo}'"
      ]
    },
    {
      "id": "focus_discord",
      "title": "Discord",
      "detail": "Discord",
      "method": "link",
