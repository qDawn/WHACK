{
  "rules": [
    {
      "id": "godot-from-note",
      "when": {
        "noteContains": "platformer"
      },
      "suggest": {
        "kind": "open_godot",
        "title": "Open the Godot project",
        "target": "${godotProject}"
      }
    },
    {
